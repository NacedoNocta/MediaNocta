@using SharedLibrairy

<div class="px-2">
    <div class="card mx-3 border-@activity.ThemeColor">
        <div class="card-header p-0 border-@activity.ThemeColor card-img-top overflow-hidden" style="aspect-ratio: 1.5 / 1;">
            <a href="#" class="d-block h-100">
                <img src="https://placehold.co/600x400"
                     alt="Thumbnail" class="img-fluid img-thumbnail" style="object-fit: cover; width: 100%; height: 100%;">
            </a>
        </div>
        <div class="card-body">
            <h5 class="card-title">
                <a href="#" class="">@activity.Title</a>
            </h5>
            <p class="card-text" style="height: 15vh; overflow: hidden;">
                @activity.Summary
            </p>
            <div class="d-flex justify-content-between">
                <a href="#" class="text-info">See more</a>
                <p class="text-muted">X months ago</p>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public IActivity activity { get; set; }
}
