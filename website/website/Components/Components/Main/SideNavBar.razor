@using SharedLibrary.Interfaces
@using Website.Services
@using Microsoft.Extensions.Localization
@using Website.Resources
@attribute [StreamRendering(true)]
@inject IActivityService ActivityService
@inject IStringLocalizer<Localization> Localizer

        <div class="col col-3">
            <div class="row card border-primary py-4 bg-dark sidebar-container">
                <ProfileInfo />
                <hr class="my-3 d-none d-lg-block">
                <iframe class="d-none d-lg-block discord-widget" 
                        src="https://discord.com/widget?id=1189296796250415195&theme=dark" 
                        allowtransparency="true" 
                        sandbox="allow-popups allow-popups-to-escape-sandbox allow-same-origin allow-scripts">
                </iframe>
                <hr class="my-3 d-none d-lg-block">
                <div>
                    <h2 class="mt-2 mb-4">@Localizer["General.PinnedArticles"]</h2>
                    <div class="row gx-1 gy-3">

                        @if (pinned is null)
                        {
                            <div class="text-center">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">@Localizer["Common.Loading"]</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            @foreach (var activity in pinned)
                            {
                                <PinnedActivityCard activity="@activity" />
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

<style>
    .sidebar-container {
        min-height: 80vh;
    }

    .discord-widget {
        height: 30vh;
    }

    @@media (max-width: 992px) {
        .sidebar-container {
            min-height: auto;
        }
    }
</style>

@code {
    private List<IActivity>? pinned;

    protected override async Task OnInitializedAsync()
    {
        pinned = await ActivityService.GetPinned();
    }

}