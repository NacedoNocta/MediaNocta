<footer class="text-center">
    <div class="container">
        <section class="">
            <div class="row text-center d-flex justify-content-center pt-5">
                <div class="col-md-2">
                    <h6 class="text-uppercase font-weight-bold">
                        <a href="#" class="text-decoration-none" @onclick="ScrollToTop">Back to top</a>
                    </h6>
                </div>
                <div class="col-md-2">
                    <h6 class="text-uppercase font-weight-bold">
                        <NavLink href="/" class="">Home page</NavLink>
                    </h6>
                </div>
                <div class="col-md-2">
                    <h6 class="text-uppercase font-weight-bold">
                        <NavLink href="/about-me" class="">About me</NavLink>
                    </h6>
                </div>
                <div class="col-md-2">
                    <h6 class="text-uppercase font-weight-bold">
                        <NavLink href="/tos" class="">Terms & confidentiality</NavLink>
                    </h6>
                </div>
            </div>
        </section>

        <hr class="col col-6 offset-3 mt-5" />
        <section class="mb-5">
            <div class="row d-flex justify-content-center">
                <div class="col-lg-8">
                    <p>
                        Media Nocta is a digital space dedicated to exploring the intersection of technology, creativity, and knowledge. 
                        Through articles, projects, and fragments of thought, we journey together toward understanding and innovation.
                    </p>
                </div>
            </div>
        </section>
    </div>
    <div class="text-center p-3 bg-dark-subtle">
        © 2023-2025 Copyright: Media Nocta
    </div>
</footer>

@inject IJSRuntime JSRuntime

@code {
    private async Task ScrollToTop()
    {
        await JSRuntime.InvokeVoidAsync("window.scrollTo", 0, 0);
    }
}
