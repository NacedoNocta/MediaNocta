@page "/blog/{blogid}/"
@using BlogLibrary
@using BlogLibrary.Interfaces
@using Website.Services
@using Humanizer
@using Markdig
@using System.Web
@using Microsoft.Extensions.Localization
@using Website.Resources
@inject BlogService BlogService
@inject CultureService CultureService
@inject ILogger<ReadBlogPost> Logger
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<Localization> Localizer
@rendermode InteractiveServer

@layout Layout.NoNavBarLayout

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="row col-12 justify-content-center">
            @if (isLoading)
            {
                <div class="d-flex justify-content-center my-5">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">@Localizer["Common.Loading"]</span>
                    </div>
                </div>
            }
            else if (hasError || post == null)
            {
                <div class="alert alert-danger" role="alert">
                    <h4 class="alert-heading">@Localizer["Blog.NotFound"]</h4>
                    <p>@Localizer["Blog.NotFoundMessage"]</p>
                    <a href="/blog" class="btn btn-outline-danger">@Localizer["Blog.ReturnToList"]</a>
                </div>
            }
            else
            {
                <article class="col-10 px-5 card border-dark bg-dark pt-4">
                    <header class="mb-4 text-center">
                        <div class="mb-3">
                            @if (post.State != BlogState.Published)
                            {
                                <span class="badge bg-secondary fs-6">@post.State</span>
                            }
                            @if (post.Featured)
                            {
                                <span class="badge bg-warning text-dark fs-6">@Localizer["Blog.Featured"]</span>
                            }
                        </div>
                        <h1 class="display-5 fw-bold">@GetLocalizedTitle()</h1>
                        <p class="text-muted mb-2">
                            @Localizer["Blog.By"] <a href="" class="text-decoration-none">@post.Author.Name</a>
                        </p>
                        <div class="text-muted small">
                            @if (post.PublishedAt.HasValue)
                            {
                                <span>@Localizer["Blog.Published"] @post.PublishedAt.Value.Humanize()</span>
                            }
                            else
                            {
                                <span>@Localizer["Blog.Created"] @post.CreatedAt.Humanize()</span>
                            }
                            @if (post.UpdatedAt.HasValue && post.UpdatedAt != post.PublishedAt)
                            {
                                <span class="ms-2">• @Localizer["Blog.Updated"] @post.UpdatedAt.Value.Humanize()</span>
                            }
                            @if (post.ReadingTimeMinutes > 0)
                            {
                                <span class="ms-2">• @post.ReadingTimeMinutes @Localizer["Blog.MinRead"]</span>
                            }
                            @if (post.Views > 0)
                            {
                                <span class="ms-2">• @post.Views @Localizer["Blog.Views"]</span>
                            }
                        </div>
                        @if (post.Tags.Any())
                        {
                            <div class="mt-3">
                                @foreach (var tag in post.Tags)
                                {
                                    <span class="badge bg-@GetTagColor(tag) me-1">@tag.Name</span>
                                }
                            </div>
                        }
                    </header>

                    <hr class="my-4">

                    <div class="content">
                        <div>@((MarkupString)GetProcessedContent())</div>
                    </div>

                    @if (post.Links.Any())
                    {
                        <hr class="my-4">
                        <div class="additional-links mb-4">
                            <strong>@Localizer["Blog.AdditionalResources"]</strong>
                            <ul class="mt-2">
                                @foreach (var link in post.Links)
                                {
                                    <li><a href="@link" target="_blank" class="text-decoration-none">@link</a></li>
                                }
                            </ul>
                        </div>
                    }
                </article>

                <!-- About the Author Section - Moved to bottom -->
                <section class="author-section mt-5">
                    <div class="card border-info">
                        <div class="card-header bg-info text-white">
                            <h4 class="mb-0">@Localizer["Blog.AboutTheAuthor"]</h4>
                        </div>
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-md-3 text-center mb-3 mb-md-0">
                                    @if (!string.IsNullOrEmpty(post.Author.ImageUrl))
                                    {
                                        <img src="@post.Author.ImageUrl" alt="@post.Author.Name" class="rounded-circle" style="width: 150px; height: 150px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-light rounded-circle d-flex align-items-center justify-content-center" style="width: 150px; height: 150px; margin: 0 auto;">
                                            <i class="fas fa-user fa-3x text-muted"></i>
                                        </div>
                                    }
                                </div>
                                <div class="col-md-9">
                                    <h5 class="card-title">
                                        <a href="" class="text-decoration-none">@post.Author.Name</a>
                                    </h5>
                                    @if (post.Author.Biography != null)
                                    {
                                        <p class="card-text">@GetLocalizedBiography()</p>
                                    }
                                    @if (HasAuthorSocialLinks())
                                    {
                                        <div class="author-links mt-3">
                                            @if (!string.IsNullOrEmpty(post.Author.Website))
                                            {
                                                <a href="@post.Author.Website" target="_blank" class="btn btn-outline-primary btn-sm me-2">
                                                    <i class="fas fa-globe"></i> @Localizer["Blog.Website"]
                                                </a>
                                            }
                                            @if (!string.IsNullOrEmpty(post.Author.Twitter))
                                            {
                                                <a href="https://twitter.com/@post.Author.Twitter.TrimStart('@')" target="_blank" class="btn btn-outline-info btn-sm me-2">
                                                    <i class="fab fa-twitter"></i> @Localizer["Blog.Twitter"]
                                                </a>
                                            }
                                            @if (!string.IsNullOrEmpty(post.Author.LinkedIn))
                                            {
                                                <a href="@post.Author.LinkedIn" target="_blank" class="btn btn-outline-primary btn-sm me-2">
                                                    <i class="fab fa-linkedin"></i> @Localizer["Blog.LinkedIn"]
                                                </a>
                                            }
                                            @if (!string.IsNullOrEmpty(post.Author.GitHub))
                                            {
                                                <a href="https://github.com/@post.Author.GitHub" target="_blank" class="btn btn-outline-dark btn-sm me-2">
                                                    <i class="fab fa-github"></i> @Localizer["Blog.GitHub"]
                                                </a>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string blogid { get; set; }

    private Blog? post = null;
    private bool isLoading = true;
    private bool hasError = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadBlogPostAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
            await JSRuntime.InvokeVoidAsync("scrollToElement", "contentTop");
    }

    private async Task LoadBlogPostAsync()
    {
        try
        {
            isLoading = true;
            hasError = false;
            StateHasChanged();

            if (Guid.TryParse(blogid, out var blogGuid))
            {
                post = await BlogService.GetPostByIdAsync(blogGuid);
                Logger.LogInformation("Loaded blog post with ID {BlogId}", blogGuid);
            }
            else
            {
                Logger.LogWarning("Invalid blog ID format: {BlogId}", blogid);
                hasError = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading blog post with ID {BlogId}", blogid);
            hasError = true;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private string GetLocalizedTitle()
    {
        if (post?.Title == null) return "";
        var currentLanguage = CultureService.GetCurrentCulture();
        return post.Title.GetText(currentLanguage);
    }

    private string GetLocalizedContent()
    {
        if (post?.Content == null) return "";
        var currentLanguage = CultureService.GetCurrentCulture();
        return post.Content.GetText(currentLanguage);
    }

    private string GetProcessedContent()
    {
        if (post?.Content == null) return "";
        
        var rawContent = GetLocalizedContent();
        if (string.IsNullOrEmpty(rawContent)) return "";

        return post.ContentType switch
        {
            ContentType.Markdown => ProcessMarkdownContent(rawContent),
            ContentType.Html => rawContent, // HTML content is used as-is
            ContentType.PlainText => ProcessPlainTextContent(rawContent),
            _ => rawContent // Fallback to raw content
        };
    }

    private string ProcessMarkdownContent(string markdownContent)
    {
        try
        {
            var pipeline = new MarkdownPipelineBuilder()
                .UseAdvancedExtensions() // Enables tables, task lists, etc.
                .UseSoftlineBreakAsHardlineBreak() // Optional: treats single line breaks as <br>
                .Build();
            
            return Markdown.ToHtml(markdownContent, pipeline);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error processing Markdown content");
            // Fallback to treating as plain text if Markdown processing fails
            return ProcessPlainTextContent(markdownContent);
        }
    }

    private string ProcessPlainTextContent(string plainTextContent)
    {
        // HTML encode the content to prevent XSS and then replace line breaks with <br> tags
        var encodedContent = HttpUtility.HtmlEncode(plainTextContent);
        return encodedContent.Replace("\n", "<br>").Replace("\r", "");
    }

    private string GetLocalizedBiography()
    {
        if (post?.Author.Biography == null) return "";
        var currentLanguage = CultureService.GetCurrentCulture();
        return post.Author.Biography.GetText(currentLanguage);
    }

    private string GetTagColor(BlogLibrary.Tag tag)
    {
        return !string.IsNullOrEmpty(tag.Color) ? tag.Color : "secondary";
    }

    private bool HasAuthorSocialLinks()
    {
        return !string.IsNullOrEmpty(post?.Author.Website) ||
               !string.IsNullOrEmpty(post?.Author.Twitter) ||
               !string.IsNullOrEmpty(post?.Author.LinkedIn) ||
               !string.IsNullOrEmpty(post?.Author.GitHub);
    }
}

<script>
    window.scrollToElement = function(elementId) {
        const element = document.getElementById(elementId);
        if (element) {
            element.scrollIntoView({ behavior: 'smooth' });
        }
    };
</script>