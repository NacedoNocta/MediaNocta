@page "/blog"
@inject BlogService BlogService
@using SharedLibrairy
@using website.Components.Components
@using website.Services
@using BlogLibrairy
@rendermode InteractiveAuto

    <div class="row justify-content-round">

        <div class="col col-9">

            @if (posts is null)
            {
                <p>Loading...</p>
            }
            else
            {
                foreach (var post in posts)
                {
                    <PostListItem post=post></PostListItem>
                }

            }

        </div>

        <div class="card border-@TextKeys.blogThemeColor col col-3 pt-3">
            <div class="row">
                <h3 class="mt-3">Search ?</h3>
                <div class="input-group">
                    <input type="text" class="form-control" placeholder="Name, Author, Tag, Summary..." aria-label="Search an article" aria-describedby="button-search">
                <button class="btn btn-@TextKeys.blogThemeColor" type="button" id="button-search">Search</button>
                </div>
            <hr class="my-4 border border-1 border-@TextKeys.blogThemeColor">

                <h3 class="px-3">Categories</h3>
                <ul class="list-group m-1">
                    <li class="list-group-item d-flex justify-content-between align-items-center mb-1">
                        CatName
                    <span class="badge bg-@TextKeys.blogThemeColor rounded-pill">99</span>
                    </li>
                </ul>
            <hr class="mt-3 border border-1 border-@TextKeys.blogThemeColor">
                <h3 class="px-3">Tags</h3>
                <ul class="list-group m-1">
                    <li class="list-group-item d-flex justify-content-between align-items-center mb-1">
                        TagName
                    <span class="badge bg-@TextKeys.blogThemeColor rounded-pill">99</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>


@code {
    private List<Blog>? posts;
    private uint pageNumber = 5;
    private uint postCountTotal = 1;

    protected override async Task OnInitializedAsync()
    {
        posts = await BlogService.GetPostList(pageNumber);
        postCountTotal = await BlogService.GetPostCount();
    }


}