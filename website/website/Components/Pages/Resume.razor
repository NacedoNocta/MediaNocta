@page "/resume"
@layout Layout.OffPage
@using Microsoft.Extensions.Localization
@using Website.Resources
@inject IStringLocalizer<Localization> Localizer

<div class="d-flex justify-content-center">
    <div class="border-1 border border-1 border-primary bg-dark-subtle text-body m-3" style="width: 21cm; height: 29.7cm;">
        <div class="m-0 p-0 d-flex">
            <div class="col-6 align-content-round">
                <h1 class="mt-3 ms-3">@Localizer["Resume.Name"]</h1>
                <p class="ms-3 col-9 mb-4">
                    <small class="col-auto text-primary-emphasis float-start">@Localizer["Resume.Company"]</small>
                    <small class="col-auto float-end">@Localizer["Resume.Age"]</small>
                </p>
                <h3 class="m-3 my-0 text-center pt-3 pe-4">@Localizer["Resume.Title"]</h3>
                <h5 class="m-3 text-center mt-0">@Localizer["Resume.Subtitle"]</h5>
            </div>
            <hr class="border border-1 border-primary my-2 me-4">
            <div class="col-6">
                <div class="m-3">
                    <p class="mb-3"><i class="bi bi-envelope me-2"></i>@Localizer["Resume.Email"]</p>
                    <p class="mb-3"><i class="bi bi-telephone me-2"></i>@Localizer["Resume.Phone"]</p>
                    <p class="mb-3"><i class="bi bi-geo-alt me-2"></i>@Localizer["Resume.Address"]</p>
                    <p class="mb-3"><i class="bi bi-moon-stars me-2"></i><a href="@Localizer["Resume.Website"]">@Localizer["Resume.Website"]</a></p>
                </div>
            </div>
        </div>
        <hr class="m-0">
        <div class="d-flex">
            <div class="col-4">
                <img src="@Assets["img/me-icon.jpg"]" alt="@Localizer["Resume.PhotoAlt"]" class="img-fluid border border-primary border-1">
            </div>
            <hr class="border border-1 border-primary m-3">
            <div class="col-8">
                <div class="pt-3">
                    <h3>@Localizer["Resume.InFewWords"]</h3>
                    <hr class="me-5">
                    <p class="pe-5 mb-0" style="text-align: justify">
                        @Localizer["Resume.Description"]
                    </p>
                </div>
            </div>
        </div>
        <hr class="m-0 mb-2">
        <div class="d-flex">
            <div class="col-4">
                <div class="ms-2 ps-1 mt-3">
                    <h3>@Localizer["Resume.Degrees"]</h3>
                    <p class="mb-1"><span class="text-warning">@Localizer["Resume.EISI"] <strong>(EISI)</strong></span>, <span class="fst-italic text-body-secondary">@Localizer["Resume.EISILevel"]</span></p>
                    <p class="mb-1"><span class="text-success">@Localizer["Resume.CDA"] <strong>(CDA)</strong></span>, <span class="fst-italic text-body-secondary">@Localizer["Resume.CDALevel"]</span></p>
                    <p class="mb-1"><span class="text-success-emphasis">@Localizer["Resume.BTS"]</span>, <span class="fst-italic text-body-secondary">@Localizer["Resume.BTSLevel"]</span></p>
                    <p class="mb-1"><span>@Localizer["Resume.Bac"]</span>, <span class="fst-italic text-body-secondary">@Localizer["Resume.BacLevel"]</span></p>
                    <p class="mb-1"><span class="text-secondary-emphasis">@Localizer["Resume.PET"]</span>, <span class="fst-italic text-body-secondary">@Localizer["Resume.PETLevel"]</span></p>
                </div>
                <hr class="ms-3 mt-3 mb-2">
                <div class="ms-2 mt-0 ps-1">
                    <h3>@Localizer["Resume.Skills"]</h3>
                    <p class="m-0">@Localizer["Resume.Development"]</p>
                    <p class="m-0 lh-sm text-body-secondary"><small>@Localizer["Resume.DevelopmentSkills"]</small></p>
                    <div class="progress mt-1 mb-3 bg-light-subtle" style="height: 0.3rem">
                        <div class="progress-bar bg-success" role="progressbar" style="width: 75%;" aria-valuenow="80" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <p class="m-0">@Localizer["Resume.Design"]</p>
                    <p class="m-0 lh-sm text-body-secondary"><small>@Localizer["Resume.DesignSkills"]</small></p>
                    <div class="progress mt-1 mb-3 bg-light-subtle" style="height: 0.3rem">
                        <div class="progress-bar bg-success" role="progressbar" style="width: 85%;" aria-valuenow="80" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <p class="m-0">@Localizer["Resume.ProjectManagement"]</p>
                    <p class="m-0 lh-sm text-body-secondary"><small>@Localizer["Resume.ProjectManagementSkills"]</small></p>
                    <div class="progress mt-1 mb-3 bg-light-subtle" style="height: 0.3rem">
                        <div class="progress-bar bg-info" role="progressbar" style="width: 60%;" aria-valuenow="80" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <p class="m-0">@Localizer["Resume.SoftSkills"]</p>
                    <p class="m-0 lh-sm text-body-secondary"><small>@Localizer["Resume.SoftSkillsList"]</small></p>
                    <div class="progress mt-1 mb-3 bg-light-subtle" style="height: 0.3rem">
                        <div class="progress-bar bg-danger" role="progressbar" style="width: 100%;" aria-valuenow="80" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            </div>
            <hr class="border border-1 border-primary m-3">
            <div class="col-8 mt-3 pe-5">
                <div class="">
                    <h3 class="">@Localizer["Resume.Experience"]</h3>
                    <h4 class="text-info mt-2">@Localizer["Resume.FullstackDeveloper"]</h4>
                    <p class="ps-2 m-0"><span class="text-info-emphasis">@Localizer["Resume.Peoplespheres"]</span><small> @Localizer["Resume.PeoplespheresDate"]</small></p>
                    <p class="ps-4 m-0 mb-1 lh-sm" style="text-align: justify">
                        @Localizer["Resume.PeoplespheresDescription"]
                    </p>
                    <p class="ps-2 lh-1 text-body-secondary fst-italic"><small>@Localizer["Resume.PeoplespheresStack"]</small></p>
                    <h4>@Localizer["Resume.ETLDeveloper"]</h4>
                    <p class="ps-2 m-0"><span class="text-info-emphasis">@Localizer["Resume.WEDA"]</span><small> @Localizer["Resume.WEDADate"]</small></p>
                    <p class="ps-4 m-0 mb-1 lh-sm" style="text-align: justify">
                        @Localizer["Resume.WEDADescription"]
                    </p>
                    <p class="ps-2 lh-1 text-body-secondary fst-italic"><small>@Localizer["Resume.WEDAStack"]</small></p>
                </div>
                <hr class="mb-2">
                <div class="">
                    <h3 class="">@Localizer["Resume.Education"]</h3>
                    <h5 class="m-0 p-0 text-info">@Localizer["Resume.EPSI"]</h5>
                    <p class="mb-2"><small>@Localizer["Resume.EPSIDate"]</small></p>
                    <p class="ps-4 m-0 mb-1 lh-sm">
                        <span>@Localizer["Resume.Workshop2022"]</span>
                        <br>
                        <span class="text-warning-emphasis">@Localizer["Resume.Workshop2022Role"]</span> <span class="text-warning">@Localizer["Resume.Workshop2022Result"]</span>
                    </p>
                    <p class="ps-4 m-0 mb-1 lh-sm">
                        <span>@Localizer["Resume.Workshop2020"]</span>
                        <br>
                        <span class="text-warning-emphasis">@Localizer["Resume.Workshop2020Role"]</span> <span class="text-warning">@Localizer["Resume.Workshop2020Result"]</span>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {

}
