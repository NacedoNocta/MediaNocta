@page "/"
@attribute [StreamRendering(true)]
@inject ActivityService ActivityService
@using SharedLibrairy.Interfaces
@using website.Components.Components
@using website.Services

<PageTitle>Media Nocta</PageTitle>

<h1> Recent activities :</h1>
<div class="row row-cols-lg-3 row-cols-1 row-cols-md-2 g-4 mt-3">
    @if (recents is null)
    {
        <h1>Loading...</h1>
    }
    else
    {
        @foreach (var activity in recents)
        {
            <ActivitySummary activity="@activity" />
        }
    }

</div>
<div class="justify-content-center d-flex mt-3">
    <button class="btn btn-lg btn-outline-primary mb-3" type="button">See more !</button>
</div>

@code {
    private List<IActivity>? recents;

    protected override async Task OnInitializedAsync()
    {
        recents = await ActivityService.GetRecent();
    }

}