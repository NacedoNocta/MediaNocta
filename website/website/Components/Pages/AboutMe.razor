@page "/about-me"
@using Website.Components.Components.AboutMe
@using Microsoft.Extensions.Localization
@using Website.Resources
@inject IStringLocalizer<Localization> Localizer

<PageTitle>@Localizer["Page.AboutMe"]</PageTitle>
<ul class="nav nav-pills mt-3 justify-content-around text-center" role="tablist">
    <li class="nav-item col col-5 " role="presentation">
        <a class="btn btn-outline-info w-100 active" data-bs-toggle="tab" href="#me" aria-selected="false" role="tab" tabindex="-1"> <h1> @Localizer["AboutMe.MeNacedo"] </h1></a>
    </li>
    <li class="vr card border-primary"></li>
    <li class="nav-item col col-5" role="presentation">
        <a class="btn btn-outline-info w-100" data-bs-toggle="tab" href="#company" aria-selected="true" role="tab"> <h1> @Localizer["AboutMe.MyPlatform"] </h1></a>
    </li>
</ul>

<hr class="mt-5">

<div id="myTabContent" class="tab-content mt-5">
    <div class="tab-pane active show fade" id="me" role="tabpanel">
        <div class="d-flex justify-content-center">
            <AboutMeNacedo />
        </div>
        <div class="d-flex justify-content-center mt-5">
            <div class="clearfix col-10 d-flex justify-content-center">
                <NavLink href="/resume" class="bg-dark h3 text-center text-decoration-none card border border-1 border-primary p-4"> @Localizer["AboutMe.ResumeLink"] </NavLink>
            </div>
        </div>
    </div>
    <div class="tab-pane fade" id="company" role="tabpanel">
        <div class="d-flex justify-content-center">
            <AboutMeMedianocta />
        </div>

    </div>
</div>
@code {

}
