{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "Realm": "medianocta",
    "Audience": "medianocta-api",
    "RequireHttpsMetadata": false,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ValidateIssuerSigningKey": true,
    "ClockSkewMinutes": 5,
    "RoleClaimType": "realm_access.roles",
    "NameClaimType": "preferred_username",
    "MapInboundClaims": false
  },
  "ReverseProxy": {
    "Routes": {
      "blogRoute" : {
        "ClusterId": "blogCluster",
        "Match": {
          "Path": "/api/blog/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/blog"
          }
        ]
      },
      "activityRoute" : {
        "ClusterId": "activityCluster",
        "Match": {
          "Path": "/api/activity/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/activity"
          }
        ]
      },
      "fragmentRoute" : {
        "ClusterId": "fragmentCluster",
        "Match": {
          "Path": "/api/fragment/{**catch-all}"
        }
      },
      "techRoute" : {
        "ClusterId": "techCluster",
        "Match": {
          "Path": "/api/tech-updates/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "techProjectsRoute" : {
        "ClusterId": "techCluster",
        "Match": {
          "Path": "/api/tech-projects/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      }
    },
    "Clusters": {
      "blogCluster": {
        "Destinations": {
          "blogDestination": {
            "Address": "http://blogapi"
          }
        }
      },
      "activityCluster": {
        "Destinations": {
          "activityDestination": {
            "Address": "http://activityapi"
          }
        }
      },
      "fragmentCluster": {
        "Destinations": {
          "fragmentDestination": {
            "Address": "http://fragmentapi"
          }
        }
      },
      "techCluster": {
        "Destinations": {
          "techDestination": {
            "Address": "http://techapi"
          }
        }
      }
    }
  }
}