@page "/fragments"
@using FragmentLibrary
@using Website.Services
@inject FragmentService FragmentService
@inject ILogger<Fragments> Logger
@inject NavigationManager Navigation
@using Website.Components.Components.Fragment
@rendermode InteractiveServer

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="mb-4">
                <h1 class="display-4 text-@(SharedLibrary.TextKeys.fragmentThemeColor)">Fragments</h1>
                <p class="lead">Discover thoughts, ideas, code snippets, and creative fragments.</p>
            </div>

            @if (isLoading)
            {
                <div class="d-flex justify-content-center my-5">
                    <div class="spinner-border text-@(SharedLibrary.TextKeys.fragmentThemeColor)" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else if (hasError)
            {
                <div class="alert alert-danger" role="alert">
                    <h4 class="alert-heading">Error Loading Fragments</h4>
                    <p>We encountered an issue while loading the fragments. Please try again later.</p>
                    <button class="btn btn-outline-danger" @onclick="@(() => LoadFragmentsAsync())">
                        <i class="fas fa-redo"></i> Retry
                    </button>
                </div>
            }
            else if (!fragments.Any())
            {
                <div class="alert alert-info" role="alert">
                    <h4 class="alert-heading">No Fragments Found</h4>
                    <p>There are currently no fragments to display.</p>
                </div>
            }
            else
            {
                <!-- Fragments List -->
                <div class="row">
                    @foreach (var fragment in fragments)
                    {
                        <FragmentCard fragment="@fragment" 
                                     IsExpanded="@(expandedFragmentId == fragment.Id)"
                                     OnVibeClicked="@HandleVibeClicked" 
                                     OnExpandClicked="@HandleExpandClicked"
                                     OnCollapseClicked="@HandleCollapseClicked" />
                    }
                </div>

                <!-- Simple Pagination (Prototype) -->
                @if (totalPages > 1)
                {
                    <nav aria-label="Fragment pagination" class="mt-4">
                        <ul class="pagination justify-content-center">
                            <!-- Previous Page -->
                            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="@(() => GoToPageAsync(currentPage - 1))" disabled="@(currentPage <= 1)">
                                    <i class="fas fa-chevron-left"></i> Previous
                                </button>
                            </li>

                            <!-- Current Page Info -->
                            <li class="page-item active">
                                <span class="page-link">@currentPage</span>
                            </li>

                            <!-- Next Page -->
                            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="@(() => GoToPageAsync(currentPage + 1))" disabled="@(currentPage >= totalPages)">
                                    Next <i class="fas fa-chevron-right"></i>
                                </button>
                            </li>
                        </ul>
                    </nav>

                    <!-- Page Info -->
                    <div class="text-center mt-3">
                        <small class="text-muted">
                            Page @currentPage of @totalPages (@fragments.Count fragments on this page)
                        </small>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private List<Fragment> fragments = new();
    private int currentPage = 1;
    private int pageSize = 6; // 2x3 grid layout
    private int totalPages = 1;
    private bool isLoading = true;
    private bool hasError = false;
    private Guid? expandedFragmentId = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadFragmentsAsync();
    }

    private async Task LoadFragmentsAsync()
    {
        try
        {
            isLoading = true;
            hasError = false;
            StateHasChanged();

            // Get fragments for current page (prototype - no total count endpoint yet)
            fragments = await FragmentService.GetFragmentsAsync(currentPage, pageSize);

            // Simple pagination calculation for prototype
            totalPages = fragments.Count < pageSize ? currentPage : currentPage + 1;

            Logger.LogInformation("Loaded {FragmentCount} fragments for page {Page}", fragments.Count, currentPage);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading fragments");
            hasError = true;
            fragments = new List<Fragment>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task GoToPageAsync(int page)
    {
        if (page < 1 || page == currentPage)
            return;

        // Collapse any expanded cards when navigating to a new page
        expandedFragmentId = null;
        currentPage = page;
        await LoadFragmentsAsync();
    }

    private async Task HandleVibeClicked(Fragment fragment)
    {
        try
        {
            var success = await FragmentService.AddVibeAsync(fragment.Id);
            if (success)
            {
                // Increment the local count for immediate UI feedback
                fragment.VibeCount++;
                StateHasChanged();
                Logger.LogInformation("Vibed with fragment {Title}!", fragment.Title);
            }
            else
            {
                Logger.LogWarning("Failed to add vibe to fragment {FragmentId}", fragment.Id);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error adding vibe to fragment {FragmentId}", fragment.Id);
        }
    }

    private async Task HandleExpandClicked(Fragment fragment)
    {
        expandedFragmentId = fragment.Id;
        StateHasChanged();
        await Task.CompletedTask;
    }

    private async Task HandleCollapseClicked(Fragment fragment)
    {
        expandedFragmentId = null;
        StateHasChanged();
        await Task.CompletedTask;
    }
}