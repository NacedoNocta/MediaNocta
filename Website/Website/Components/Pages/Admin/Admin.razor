@page "/admin"
@using Microsoft.Extensions.Localization
@using Website.Resources
@using Website.Authentication.Interfaces
@inject NavigationManager Navigation
@inject IStringLocalizer<Localization> Localizer
@inject ISessionManager SessionManager
@rendermode InteractiveServer

<PageTitle>Admin Dashboard - Media Nocta</PageTitle>

@if (isLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 50vh;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (!isAuthorized)
{
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="text-center">
                    <div class="mb-4">
                        <i class="fas fa-user-shield text-danger" style="font-size: 4rem;"></i>
                    </div>
                    
                    <h1 class="display-5 fw-bold text-danger mb-3">
                        Access Denied
                    </h1>
                    
                    <p class="lead text-muted mb-4">
                        You don't have permission to access the admin dashboard. Administrator privileges are required.
                    </p>
                    
                    <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center">
                        <button class="btn btn-primary px-4 py-2" @onclick="GoHome">
                            <i class="fas fa-home me-2"></i>
                            Go to Home
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="container-fluid mt-4">
        <div class="row g-4">
            <!-- Blog Management Card -->
            <div class="col-lg-6 col-xl-3">
                <div class="card h-100 border-1 shadow-sm hover-card">
                    <div class="card-body d-flex flex-column text-center p-4">
                        <div class="mb-3">
                            <i class="fas fa-blog text-primary" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-3">Blog Management</h5>
                        <p class="card-text text-muted flex-grow-1">
                            Manage blog posts, categories, and publishing settings
                        </p>
                        <button class="btn btn-primary mt-auto" @onclick='() => NavigateToSubmenu("blog")'>
                            <i class="fas fa-arrow-right me-2"></i>Access
                        </button>
                    </div>
                </div>
            </div>

            <!-- Tech Management Card -->
            <div class="col-lg-6 col-xl-3">
                <div class="card h-100 border-1 shadow-sm hover-card">
                    <div class="card-body d-flex flex-column text-center p-4">
                        <div class="mb-3">
                            <i class="fas fa-code text-success" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-3">Tech Projects</h5>
                        <p class="card-text text-muted flex-grow-1">
                            Manage technical projects, portfolio items, and showcases
                        </p>
                        <button class="btn btn-success mt-auto" @onclick='() => NavigateToSubmenu("tech")'>
                            <i class="fas fa-arrow-right me-2"></i>Access
                        </button>
                    </div>
                </div>
            </div>

            <!-- Fragments Management Card -->
            <div class="col-lg-6 col-xl-3">
                <div class="card h-100 border-1 shadow-sm hover-card">
                    <div class="card-body d-flex flex-column text-center p-4">
                        <div class="mb-3">
                            <i class="fas fa-puzzle-piece text-warning" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-3">Fragments</h5>
                        <p class="card-text text-muted flex-grow-1">
                            Manage content fragments, snippets, and micro-content
                        </p>
                        <button class="btn btn-warning mt-auto" @onclick='() => NavigateToSubmenu("fragments")'>
                            <i class="fas fa-arrow-right me-2"></i>Access
                        </button>
                    </div>
                </div>
            </div>

            <!-- Learn Management Card -->
            <div class="col-lg-6 col-xl-3">
                <div class="card h-100 border-1 shadow-sm hover-card">
                    <div class="card-body d-flex flex-column text-center p-4">
                        <div class="mb-3">
                            <i class="fas fa-graduation-cap text-info" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-3">Learn Content</h5>
                        <p class="card-text text-muted flex-grow-1">
                            Manage learning resources, tutorials, and educational content
                        </p>
                        <button class="btn btn-info mt-auto" @onclick='() => NavigateToSubmenu("learn")'>
                            <i class="fas fa-arrow-right me-2"></i>Access
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Stats Section -->
        <div class="row mt-5">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-light border-0">
                        <h6 class="card-title mb-0 fw-bold">
                            <i class="fas fa-chart-bar me-2 text-primary"></i>Quick Overview
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-md-3">
                                <div class="p-3">
                                    <i class="fas fa-blog text-primary mb-2" style="font-size: 2rem;"></i>
                                    <h4 class="fw-bold">--</h4>
                                    <small class="text-muted">Blog Posts</small>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="p-3">
                                    <i class="fas fa-code text-success mb-2" style="font-size: 2rem;"></i>
                                    <h4 class="fw-bold">--</h4>
                                    <small class="text-muted">Tech Projects</small>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="p-3">
                                    <i class="fas fa-puzzle-piece text-warning mb-2" style="font-size: 2rem;"></i>
                                    <h4 class="fw-bold">--</h4>
                                    <small class="text-muted">Fragments</small>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="p-3">
                                    <i class="fas fa-graduation-cap text-info mb-2" style="font-size: 2rem;"></i>
                                    <h4 class="fw-bold">--</h4>
                                    <small class="text-muted">Learn Items</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .hover-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }
    
    .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }
    
    .card-body .btn {
        transition: all 0.2s ease-in-out;
    }
    
    .card-body .btn:hover {
        transform: translateX(5px);
    }
</style>

@code {
    private bool isLoading = true;
    private bool isAuthorized = false;
    private Website.Authentication.Models.UserSession? currentUser;

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthorization();
    }

    private async Task CheckAuthorization()
    {
        try
        {
            currentUser = await SessionManager.GetCurrentSessionAsync();
            
            if (currentUser == null)
            {
                // User is not authenticated
                var returnUrl = Uri.EscapeDataString("/admin");
                Navigation.NavigateTo($"/Account/Login?ReturnUrl={returnUrl}", forceLoad: true);
                return;
            }

            // Check if user has website-admin role
            isAuthorized = currentUser.Roles.Contains("website-admin");
        }
        catch (Exception ex)
        {
            // Log error if logging is available
            Console.WriteLine($"Error checking authorization: {ex.Message}");
            isAuthorized = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoHome()
    {
        Navigation.NavigateTo("/", forceLoad: true);
    }

    private void NavigateToSubmenu(string section)
    {
        // For now, these will just show a placeholder
        // Later these will navigate to actual admin submenus
        Navigation.NavigateTo($"/admin/{section}");
    }
}