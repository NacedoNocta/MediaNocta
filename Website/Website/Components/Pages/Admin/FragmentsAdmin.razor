@page "/admin/fragments"
@using Website.Authentication.Interfaces
@inject NavigationManager Navigation
@inject ISessionManager SessionManager
@rendermode InteractiveServer

<PageTitle>Fragments Management - Admin Dashboard</PageTitle>

@if (isLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 50vh;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (!isAuthorized)
{
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="text-center">
                    <div class="mb-4">
                        <i class="fas fa-user-shield text-danger" style="font-size: 4rem;"></i>
                    </div>
                    <h1 class="display-5 fw-bold text-danger mb-3">Access Denied</h1>
                    <p class="lead text-muted mb-4">Administrator privileges required.</p>
                    <button class="btn btn-primary" @onclick="GoToAdmin">Back to Admin</button>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="container-fluid mt-4">
        <div class="row">
            <div class="col-12">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/admin">Admin</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Fragments</li>
                    </ol>
                </nav>
                
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1 class="display-6 fw-bold text-warning">
                        <i class="fas fa-puzzle-piece me-3"></i>Fragments Management
                    </h1>
                </div>
                
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-body text-center py-5">
                                <i class="fas fa-tools text-muted mb-3" style="font-size: 4rem;"></i>
                                <h3 class="text-muted">Coming Soon</h3>
                                <p class="text-muted">Fragments management features will be implemented here.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool isAuthorized = false;

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthorization();
    }

    private async Task CheckAuthorization()
    {
        try
        {
            var currentUser = await SessionManager.GetCurrentSessionAsync();
            
            if (currentUser == null)
            {
                var returnUrl = Uri.EscapeDataString("/admin/fragments");
                Navigation.NavigateTo($"/Account/Login?ReturnUrl={returnUrl}", forceLoad: true);
                return;
            }

            isAuthorized = currentUser.Roles.Contains("website-admin");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error checking authorization: {ex.Message}");
            isAuthorized = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoToAdmin()
    {
        Navigation.NavigateTo("/admin");
    }
}