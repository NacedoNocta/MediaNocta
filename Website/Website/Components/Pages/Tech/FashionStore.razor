@page "/tech/fashion-store"
@using SharedLibrary
@using TechLibrary
@using Microsoft.Extensions.Localization
@using Website.Resources
@using Website.Components.Components.Tech
@inject IStringLocalizer<Localization> Localizer
@inject ILogger<FashionStore> Logger

<div class="row">
    <div class="col-12">
        <div class="mb-4">
            
            <div class="text-center mb-5">
                <h1 class="display-4 text-@(TextKeys.techThemeColor)">Fashion Store</h1>
                <p class="lead text-body-tertiary">Modern e-commerce platform for fashion retail</p>
            </div>
        </div>

        <!-- Project Overview -->
        <div class="row mb-5">
            <div class="col-md-8">
                <div class="card border-info">
                    <div class="card-body">
                        <h3 class="card-title text-@(TextKeys.techThemeColor)">Project Overview</h3>
                        <p class="card-text">
                            Fashion Store is a comprehensive e-commerce solution designed specifically for fashion retailers. 
                            It features advanced inventory management, customer analytics, and a modern shopping experience 
                            optimized for fashion products.
                        </p>
                        
                        <h4 class="mt-4">Key Features</h4>
                        <ul class="list-unstyled">
                            <li class="mb-2"><i class="bi bi-check-circle text-success"></i> Product catalog with size/color variants</li>
                            <li class="mb-2"><i class="bi bi-check-circle text-success"></i> Advanced filtering and search</li>
                            <li class="mb-2"><i class="bi bi-check-circle text-success"></i> Inventory management system</li>
                            <li class="mb-2"><i class="bi bi-check-circle text-success"></i> Customer analytics dashboard</li>
                            <li class="mb-2"><i class="bi bi-check-circle text-success"></i> Mobile-responsive design</li>
                            <li class="mb-2"><i class="bi bi-check-circle text-success"></i> Payment gateway integration</li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-info">
                    <div class="card-body">
                        <h5 class="card-title">Project Details</h5>
                        <table class="table table-sm">
                            <tr><td><strong>Technology:</strong></td><td>ASP.NET Core</td></tr>
                            <tr><td><strong>Database:</strong></td><td>PostgreSQL</td></tr>
                            <tr><td><strong>Frontend:</strong></td><td>Blazor Server</td></tr>
                            <tr><td><strong>Status:</strong></td><td><span class="badge bg-success">Active</span></td></tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Technical Sections -->
        <div class="row mb-5">
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-gear"></i> Technical Details</h5>
                        <p class="card-text">Explore the technical architecture and implementation details of this project.</p>
                        <a href="/tech/fashion-store/technical" class="btn btn-outline-@(TextKeys.techThemeColor)">View Technical Details</a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-list-check"></i> Functional Overview</h5>
                        <p class="card-text">Learn about the business logic and functional requirements implementation.</p>
                        <a href="/tech/fashion-store/functional" class="btn btn-outline-@(TextKeys.techThemeColor)">View Functional Details</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Activity Feed -->
        <div class="row">
            <div class="col-12">
                <h3 class="mb-4 text-@(TextKeys.techThemeColor)">Project Updates</h3>
                <ProjectActivity ProjectId="@ProjectKeys.FashionStore.ToSlug()" />
            </div>
        </div>
    </div>
</div>