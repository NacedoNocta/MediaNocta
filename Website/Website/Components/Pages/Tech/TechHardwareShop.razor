@page "/tech/tech-hardware-shop"
@using SharedLibrary
@using TechLibrary
@using Microsoft.Extensions.Localization
@using Website.Resources
@using Website.Components.Components.Tech
@inject IStringLocalizer<Localization> Localizer

<div class="row">
    <div class="col-12">
        <div class="mb-4">
            
            <div class="text-center mb-5">
                <h1 class="display-4 text-@(TextKeys.techThemeColor)">Tech Hardware Shop</h1>
                <p class="lead text-body-tertiary">Comprehensive hardware marketplace with detailed specifications</p>
            </div>
        </div>

        <!-- Project Overview -->
        <div class="row mb-5">
            <div class="col-md-8">
                <div class="card border-info">
                    <div class="card-body">
                        <h3 class="card-title text-@(TextKeys.techThemeColor)">Project Overview</h3>
                        <p class="card-text">
                            A specialized e-commerce platform for computer hardware and electronics. Features advanced product 
                            comparisons, technical specifications database, and compatibility checking tools.
                        </p>
                        
                        <h4 class="mt-4">Key Features</h4>
                        <ul class="list-unstyled">
                            <li class="mb-2"><i class="bi bi-check-circle text-success"></i> Detailed technical specifications</li>
                            <li class="mb-2"><i class="bi bi-check-circle text-success"></i> Product comparison tools</li>
                            <li class="mb-2"><i class="bi bi-check-circle text-success"></i> Compatibility checker</li>
                            <li class="mb-2"><i class="bi bi-check-circle text-success"></i> Price tracking and alerts</li>
                            <li class="mb-2"><i class="bi bi-check-circle text-success"></i> Expert reviews and ratings</li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-info">
                    <div class="card-body">
                        <h5 class="card-title">Project Details</h5>
                        <table class="table table-sm">
                            <tr><td><strong>Technology:</strong></td><td>ASP.NET Core</td></tr>
                            <tr><td><strong>Database:</strong></td><td>PostgreSQL</td></tr>
                            <tr><td><strong>Frontend:</strong></td><td>Blazor Server</td></tr>
                            <tr><td><strong>Status:</strong></td><td><span class="badge bg-warning">Development</span></td></tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Activity Feed -->
        <div class="row">
            <div class="col-12">
                <h3 class="mb-4 text-@(TextKeys.techThemeColor)">Project Updates</h3>
                <ProjectActivity ProjectId="@ProjectKeys.TechHardwareShop.ToSlug()" />
            </div>
        </div>
    </div>
</div>