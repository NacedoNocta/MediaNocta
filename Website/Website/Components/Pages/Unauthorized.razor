@page "/Unauthorized"
@using Microsoft.Extensions.Localization
@using Website.Resources
@inject NavigationManager Navigation
@inject IStringLocalizer<Localization> Localizer

<PageTitle>Unauthorized - Media Nocta</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="text-center">
                <div class="mb-4">
                    <i class="fas fa-lock text-warning" style="font-size: 4rem;"></i>
                </div>
                
                <h1 class="display-5 fw-bold text-primary mb-3">
                    @Localizer["Error.Unauthorized.Title"]
                </h1>
                
                <p class="lead text-muted mb-4">
                    @Localizer["Error.Unauthorized.Message"]
                </p>
                
                <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center">
                    <button class="btn btn-primary px-4 py-2" @onclick="GoHome">
                        <i class="fas fa-home me-2"></i>
                        @Localizer["Navigation.Home"]
                    </button>
                    
                    <button class="btn btn-outline-primary px-4 py-2" @onclick="GoToLogin">
                        <i class="fas fa-sign-in-alt me-2"></i>
                        @Localizer["Auth.Login"]
                    </button>
                </div>
                
                <div class="mt-4">
                    <small class="text-muted">
                        @Localizer["Error.Unauthorized.Help"]
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private void GoHome()
    {
        Navigation.NavigateTo("/", forceLoad: true);
    }
    
    private void GoToLogin()
    {
        var currentUrl = Navigation.Uri;
        var returnUrl = Uri.EscapeDataString(new Uri(currentUrl).PathAndQuery);
        Navigation.NavigateTo($"/Account/Login?ReturnUrl={returnUrl}", forceLoad: true);
    }
}