@inject IJSRuntime JSRuntime
@inject IStringLocalizer<Localization> Localizer

<footer class="text-center">
    <div class="container">
        <section class="">
            <div class="row text-center d-flex justify-content-center pt-5">
                <div class="col-md-2">
                    <h6 class="text-uppercase font-weight-bold">
                        <a href="#" class="text-decoration-none" @onclick="ScrollToTop">@Localizer["Footer.BackToTop"]</a>
                    </h6>
                </div>
                <div class="col-md-2">
                    <h6 class="text-uppercase font-weight-bold">
                        <NavLink href="/" class="">@Localizer["Footer.HomePage"]</NavLink>
                    </h6>
                </div>
                <div class="col-md-2">
                    <h6 class="text-uppercase font-weight-bold">
                        <NavLink href="/about-me" class="">@Localizer["Footer.AboutMe"]</NavLink>
                    </h6>
                </div>
                <div class="col-md-2">
                    <h6 class="text-uppercase font-weight-bold">
                        <NavLink href="/tos" class="">@Localizer["Footer.TermsAndPrivacy"]</NavLink>
                    </h6>
                </div>
            </div>
        </section>

        <hr class="col col-6 offset-3 mt-5" />
        <section class="mb-5">
            <div class="row d-flex justify-content-center">
                <div class="col-lg-8">
                    <p>
                        @Localizer["Footer.Description"]
                    </p>
                </div>
            </div>
        </section>
    </div>
    <div class="text-center p-3 bg-dark-subtle">
        @Localizer["Footer.Copyright"]
    </div>
</footer>

@code {
    private async Task ScrollToTop()
    {
        await JSRuntime.InvokeVoidAsync("window.scrollTo", 0, 0);
    }
}
