@using TechLibrary
@using SharedLibrary
@using Humanizer
@using Microsoft.Extensions.Localization
@using Website.Resources
@using Website.Services
@inject IStringLocalizer<Localization> Localizer
@inject ILogger<ProjectActivity> Logger
@inject TechUpdateService TechUpdateService
@rendermode InteractiveServer

<div class="row">
    @if (_isLoading)
    {
        <div class="col-12">
            <div class="d-flex justify-content-center my-5">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">@Localizer["Common.Loading"]</span>
                </div>
            </div>
        </div>
    }
    else if (_hasError)
    {
        <div class="col-12">
            <div class="alert alert-danger" role="alert">
                <h4 class="alert-heading">@Localizer["Error.LoadingUpdates"]</h4>
                <p>@Localizer["Error.LoadingUpdatesMessage"]</p>
                <button class="btn btn-outline-danger" @onclick="@(LoadUpdatesAsync)">
                    <i class="bi bi-arrow-clockwise"></i> @Localizer["Common.Retry"]
                </button>
            </div>
        </div>
    }
    else if (!_updates.Any())
    {
        <div class="col-12">
            <div class="alert alert-info" role="alert">
                <h4 class="alert-heading">@Localizer["Empty.NoUpdatesFound"]</h4>
                <p>@Localizer["Empty.NoUpdatesMessage"]</p>
            </div>
        </div>
    }
    else
    {
        @foreach (var update in _updates)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card border-@(TextKeys.techThemeColor) h-100">
                    @if (!string.IsNullOrEmpty(update.ImageUrl))
                    {
                        <div class="card-img-top overflow-hidden">
                            <img src="@update.ImageUrl" alt="Update image" class="card-img border border-1 border-@(TextKeys.techThemeColor) object-fit-cover w-100" style="object-fit: cover;aspect-ratio: 2 / 1">
                        </div>
                    }
                    <div class="card-body d-flex flex-column">
                        <h6 class="card-title text-@(TextKeys.techThemeColor)">
                            @GetLocalizedTitle(update)
                            @if (!string.IsNullOrEmpty(update.UpdateType))
                            {
                                <span class="badge bg-@(TextKeys.techThemeColor) ms-2">@update.UpdateType</span>
                            }
                        </h6>
                        <p class="card-text flex-grow-1 small">
                            @GetSummaryText(update)
                        </p>
                        <div class="card-footer text-muted mt-auto ps-0 pb-0">
                            <small class="text-muted">@GetTimeAgoText(update)</small>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Pagination Controls -->
        @if (_totalPages > 1)
        {
            <div class="col-12">
                <nav aria-label="Updates pagination" class="mt-4">
                    <ul class="pagination justify-content-center">
                        <!-- Previous Page -->
                        <li class="page-item @(_currentPage <= 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="@(() => GoToPageAsync(_currentPage - 1))" disabled="@(_currentPage <= 1)">
                                <i class="bi bi-chevron-left"></i> @Localizer["Common.Previous"]
                            </button>
                        </li>

                        <!-- Page Numbers -->
                        @{
                            var startPage = Math.Max(1, (int)_currentPage - 2);
                            var endPage = Math.Min((int)_totalPages, (int)_currentPage + 2);
                        }
                        @for (int page = startPage; page <= endPage; page++)
                        {
                            var pageNumber = (uint)page;
                            <li class="page-item @(pageNumber == _currentPage ? "active" : "")">
                                <button class="page-link" @onclick="@(() => GoToPageAsync(pageNumber))">
                                    @(page)
                                </button>
                            </li>
                        }

                        <!-- Next Page -->
                        <li class="page-item @(_currentPage >= _totalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="@(() => GoToPageAsync(_currentPage + 1))" disabled="@(_currentPage >= _totalPages)">
                                @Localizer["Common.Next"] <i class="bi bi-chevron-right"></i>
                            </button>
                        </li>
                    </ul>
                </nav>

                <!-- Page Info -->
                <div class="text-center mt-3">
                    <small class="text-muted">
                        @Localizer["Pagination.Page"] @_currentPage @Localizer["Pagination.Of"] @_totalPages (@_totalUpdates @Localizer["Pagination.TotalUpdates"])
                    </small>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public string ProjectId { get; set; } = string.Empty;

    private List<TechUpdate> _updates = new();
    private uint _currentPage = 1;
    private readonly uint _pageSize = 6; // 2x3 grid layout
    private uint _totalUpdates = 0;
    private uint _totalPages = 0;
    private bool _isLoading = true;
    private bool _hasError = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadUpdatesAsync();
    }

    private async Task LoadUpdatesAsync()
    {
        try
        {
            _isLoading = true;
            _hasError = false;
            StateHasChanged();

            // Get the total count first
            _totalUpdates = await TechUpdateService.GetTechUpdatesCountByProjectIdAsync(ProjectId);
            _totalPages = _totalUpdates > 0 ? (uint)Math.Ceiling((double)_totalUpdates / _pageSize) : 0;

            // Get updates for the current page
            _updates = await TechUpdateService.GetTechUpdatesByProjectIdAsync(ProjectId, _currentPage, _pageSize);

            Logger.LogInformation("Loaded {UpdateCount} tech updates for project {ProjectId}, page {Page}", _updates.Count, ProjectId, _currentPage);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading tech updates for project {ProjectId}", ProjectId);
            _hasError = true;
            _updates = new List<TechUpdate>();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task GoToPageAsync(uint page)
    {
        if (page < 1 || page > _totalPages || page == _currentPage)
            return;

        _currentPage = page;
        await LoadUpdatesAsync();
    }

    private string GetLocalizedTitle(TechUpdate update)
    {
        return update.Title?.English ?? "Untitled Update";
    }

    private string GetSummaryText(TechUpdate update)
    {
        var summary = update.Summary?.English ?? "";
        return summary.Truncate(100);
    }

    private string GetTimeAgoText(TechUpdate update)
    {
        if (update.CreatedAt == default)
            return "";

        return update.CreatedAt.Humanize().Transform(To.SentenceCase);
    }
}