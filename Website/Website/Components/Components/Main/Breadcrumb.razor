@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.Extensions.Localization
@using Website.Resources
@inject IStringLocalizer<Localization> Localizer
@inject NavigationManager NavigationManager
@implements IDisposable

<div class="container-fluid px-4 pt-2 pb-0 mb-0 border-bottom">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            @foreach (var breadcrumb in _breadcrumbs)
            {
                @if (breadcrumb.IsActive)
                {
                    <li class="breadcrumb-item active text-primary-emphasis" aria-current="page">
                        @breadcrumb.Text
                    </li>
                }
                else
                {
                    <li class="breadcrumb-item">
                        <a href="@breadcrumb.Url" class="text-decoration-none text-body-tertiary">@breadcrumb.Text</a>
                    </li>
                }
            }
        </ol>
    </nav>
</div>

@code {
    private List<BreadcrumbItem> _breadcrumbs = new();

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        GenerateBreadcrumbs();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        GenerateBreadcrumbs();
        InvokeAsync(StateHasChanged);
    }

    private void GenerateBreadcrumbs()
    {
        _breadcrumbs.Clear();
        
        var uri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var segments = uri.Split('/', StringSplitOptions.RemoveEmptyEntries);
        
        // Always add Home
        _breadcrumbs.Add(new BreadcrumbItem
        {
            Text = Localizer["Navigation.Homepage"],
            Url = "/",
            IsActive = segments.Length == 0
        });
        
        var currentPath = "";
        for (int i = 0; i < segments.Length; i++)
        {
            var segment = segments[i];
            currentPath += "/" + segment;
            var isLast = i == segments.Length - 1;
            
            var breadcrumbText = GetBreadcrumbText(segment, segments, i);
            
            _breadcrumbs.Add(new BreadcrumbItem
            {
                Text = breadcrumbText,
                Url = currentPath,
                IsActive = isLast
            });
        }
    }

    private string GetBreadcrumbText(string segment, string[] segments, int index)
    {
        return segment.ToLower() switch
        {
            "blog" => Localizer["Navigation.BlogAndArticles"],
            "tech" => Localizer["Navigation.TechProjects"],
            "fragments" => Localizer["Navigation.Fragments"],
            "learn" => Localizer["Navigation.LearnAndAct"],
            "about-me" => Localizer["Navigation.AboutMe"],
            _ => FormatSegment(segment)
        };
    }

    private string FormatSegment(string segment)
    {
        // Handle URL-decoded segments and format them nicely
        return segment.Replace("-", " ")
                     .Replace("_", " ")
                     .Split(' ')
                     .Select(word => char.ToUpper(word[0]) + word.Substring(1).ToLower())
                     .Aggregate((a, b) => a + " " + b);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private class BreadcrumbItem
    {
        public string Text { get; set; } = string.Empty;
        public string Url { get; set; } = string.Empty;
        public bool IsActive { get; set; }
    }
}