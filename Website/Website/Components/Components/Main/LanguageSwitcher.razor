@using Microsoft.Extensions.Localization
@using Website.Services
@using Website.Resources
@inject CultureService CultureService
@inject IStringLocalizer<Localization> Localizer
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="dropdown">
    <button class="btn btn-outline-primary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="fas fa-globe me-1"></i>@GetCurrentLanguageName()
    </button>
    <ul class="dropdown-menu">
        @foreach (var culture in SupportedCultures)
        {
            <li>
                <button class="dropdown-item @(culture.Code == CurrentCulture ? "active bg-primary" : "")" 
                        type="button" 
                        @onclick="() => OnLanguageChanged(culture.Code)">
                    @culture.Name
                </button>
            </li>
        }
    </ul>
</div>

@code {
    private string CurrentCulture = "en";
    private List<(string Code, string Name)> SupportedCultures = new();

    protected override void OnInitialized()
    {
        CurrentCulture = CultureService.GetCurrentCulture();
        SupportedCultures = CultureService.GetSupportedCultures();
    }

    private string GetCurrentLanguageName()
    {
        return SupportedCultures.FirstOrDefault(c => c.Code == CurrentCulture).Name ?? CurrentCulture.ToUpper();
    }

    private void OnLanguageChanged(string newCulture)
    {
        if (newCulture != CurrentCulture)
        {
            var currentUri = new Uri(Navigation.Uri);
            var returnUrl = currentUri.PathAndQuery;
            Navigation.NavigateTo($"/Culture/SetCulture?culture={newCulture}&returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
        }
    }   
}