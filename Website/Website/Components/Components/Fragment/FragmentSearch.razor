@using FragmentLibrary
@using Website.Services
@inject FragmentService FragmentService
@inject ILogger<FragmentSearch> Logger

<div class="mb-4">
    <div class="row">
        <div class="col-md-8">
            <div class="input-group">
                <span class="input-group-text">
                    <i class="fas fa-search"></i>
                </span>
                <input type="text" class="form-control" 
                       placeholder="Search fragments..." 
                       @bind="searchQuery" 
                       @onkeypress="@(async (e) => { if (e.Key == "Enter") await SearchAsync(); })"
                       @bind:event="oninput" />
                <button class="btn btn-outline-@(SharedLibrary.TextKeys.fragmentThemeColor)" 
                        @onclick="SearchAsync" 
                        disabled="@(string.IsNullOrWhiteSpace(searchQuery))">
                    Search
                </button>
            </div>
        </div>
        <div class="col-md-4">
            <select class="form-select" @bind="selectedTypeTag">
                <option value="">All Types</option>
                @foreach (var type in fragmentTypes)
                {
                    <option value="@type.Name">@type.Name.ToUpper()</option>
                }
            </select>
        </div>
    </div>
    @if (isSearching)
    {
        <div class="mt-2">
            <div class="d-flex align-items-center">
                <div class="spinner-border spinner-border-sm text-@(SharedLibrary.TextKeys.fragmentThemeColor) me-2" role="status">
                    <span class="visually-hidden">Searching...</span>
                </div>
                <span class="text-muted">Searching fragments...</span>
            </div>
        </div>
    }
    @if (hasSearched && !isSearching)
    {
        <div class="mt-2">
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted">
                    Found @searchResults.Count fragment(s) for "@lastSearchQuery"
                    @if (!string.IsNullOrEmpty(lastSearchTypeTag))
                    {
                        <span> in "@lastSearchTypeTag"</span>
                    }
                </span>
                <button class="btn btn-outline-secondary btn-sm" @onclick="ClearSearch">
                    <i class="fas fa-times"></i> Clear
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public EventCallback<List<Fragment>> OnSearchResults { get; set; }

    [Parameter]
    public EventCallback OnClearSearch { get; set; }

    private string searchQuery = string.Empty;
    private string selectedTypeTag = string.Empty;
    private List<Fragment> searchResults = new();
    private List<FragmentType> fragmentTypes = new();
    private bool isSearching = false;
    private bool hasSearched = false;
    private string lastSearchQuery = string.Empty;
    private string lastSearchTypeTag = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadFragmentTypesAsync();
    }

    private async Task LoadFragmentTypesAsync()
    {
        try
        {
            fragmentTypes = await FragmentService.GetFragmentTypesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load fragment types");
        }
    }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
            return;

        try
        {
            isSearching = true;
            StateHasChanged();

            var typeTag = string.IsNullOrEmpty(selectedTypeTag) ? null : selectedTypeTag;
            searchResults = await FragmentService.SearchFragmentsAsync(searchQuery.Trim(), typeTag);
            
            lastSearchQuery = searchQuery.Trim();
            lastSearchTypeTag = typeTag ?? string.Empty;
            hasSearched = true;

            Logger.LogInformation("Search completed: found {Count} fragments", searchResults.Count);

            if (OnSearchResults.HasDelegate)
            {
                await OnSearchResults.InvokeAsync(searchResults);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during search");
            searchResults = new List<Fragment>();
        }
        finally
        {
            isSearching = false;
            StateHasChanged();
        }
    }

    private async Task ClearSearch()
    {
        searchQuery = string.Empty;
        selectedTypeTag = string.Empty;
        searchResults = new();
        hasSearched = false;
        lastSearchQuery = string.Empty;
        lastSearchTypeTag = string.Empty;

        if (OnClearSearch.HasDelegate)
        {
            await OnClearSearch.InvokeAsync();
        }

        StateHasChanged();
    }
}