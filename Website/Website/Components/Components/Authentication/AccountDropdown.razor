@using Website.Authentication.Routes
@using Microsoft.Extensions.Localization
@using Website.Resources
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject IStringLocalizer<Localization> Localizer
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<AuthorizeView>
    <Authorized>
        <div class="dropdown">
            <button class="btn btn-outline-primary dropdown-toggle px-4 py-3 mx-4"
                    type="button"
                    id="accountDropdown"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">
                <i class="bi bi-person-circle me-2"></i>
                @GetDisplayName(context.User)
            </button>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="accountDropdown">
                <li>
                    <h6 class="dropdown-header">@GetUserEmail(context.User)</h6>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <span class="dropdown-item-text text-muted small">
                        @Localizer["Auth.Roles"]: @GetUserRoles(context.User)
                    </span>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item" href="/Account/Profile">
                        <i class="bi bi-person me-2"></i>
                        @Localizer["Auth.Profile"]
                    </a>
                </li>
                <li>
                    <button class="dropdown-item text-danger" @onclick="HandleLogout">
                        <i class="bi bi-box-arrow-right me-2"></i>
                        @Localizer["Auth.Logout"]
                    </button>
                </li>
            </ul>
        </div>
    </Authorized>
    <NotAuthorized>
        <button class="mx-4 btn btn-outline-primary px-4 py-3" @onclick="HandleLogin">
            <i class="bi bi-box-arrow-in-right me-2"></i>
            @Localizer["Auth.Login"]
        </button>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string GetDisplayName(System.Security.Claims.ClaimsPrincipal user)
    {
        return user.FindFirst("username")?.Value
            ?? user.FindFirst("preferred_username")?.Value
            ?? user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
            ?? user.Identity?.Name
            ?? Localizer["Auth.Account"];
    }

    private string GetUserEmail(System.Security.Claims.ClaimsPrincipal user)
    {
        return user.FindFirst("email")?.Value
            ?? user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
            ?? "";
    }

    private string GetUserRoles(System.Security.Claims.ClaimsPrincipal user)
    {
        var roles = user.FindAll(System.Security.Claims.ClaimTypes.Role)
            .Select(c => c.Value)
            .Where(r => r == "user" || r == "admin")
            .ToList();

        return roles.Any() ? string.Join(", ", roles) : Localizer["Auth.NoRoles"];
    }

    private void HandleLogin()
    {
        Navigation.NavigateTo(AuthenticationRoutes.LoginPath, forceLoad: true);
    }

    private void HandleLogout()
    {
        Navigation.NavigateTo(AuthenticationRoutes.LogoutPath, forceLoad: true);
    }
}
