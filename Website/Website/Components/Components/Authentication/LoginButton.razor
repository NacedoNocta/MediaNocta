@using Website.Authentication.Routes
@using Website.Authentication.Interfaces
@using Website.Authentication.Models
@using Microsoft.Extensions.Localization
@using Website.Resources
@inject NavigationManager Navigation
@inject IAuthenticationService AuthService
@inject ISessionManager SessionManager
@inject IStringLocalizer<Localization> Localizer
@rendermode InteractiveServer
@implements IDisposable

<div class="auth-button">
    @if (isAuthenticated)
    {
        <div class="d-flex align-items-center gap-2">
            @if (isWebsiteAdmin)
            {
                <NavLink href="/admin" class="btn btn-outline-warning px-3 py-3" ActiveClass="bg-warning">
                    <i class="fas fa-cog me-2"></i>Admin
                </NavLink>
            }
            <button class="btn btn-outline-danger px-4 py-3" @onclick="HandleLogout">
                @Localizer["Auth.Logout"]
            </button>
        </div>
    }
    else
    {
        <button class="btn btn-outline-primary px-4 py-3" @onclick="HandleLogin">
            @Localizer["Auth.Login"]
        </button>
    }
</div>

@code {
    private bool isAuthenticated = false;
    private bool isWebsiteAdmin = false;
    private UserSession? session;

    protected override async Task OnInitializedAsync()
    {
        SessionManager.SessionChanged += OnSessionChanged;
        await RefreshAuthenticationState();
    }

    private async Task RefreshAuthenticationState()
    {
        session = await SessionManager.GetCurrentSessionAsync();
        isAuthenticated = session != null && !session.IsKeycloakSessionExpired;
        isWebsiteAdmin = session?.Roles?.Contains("website-admin") == true;
        StateHasChanged();
    }

    private void OnSessionChanged(object? sender, UserSession? updatedSession)
    {
        session = updatedSession;
        isAuthenticated = session != null && !session.IsKeycloakSessionExpired;
        isWebsiteAdmin = session?.Roles?.Contains("website-admin") == true;
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleLogin()
    {
        // Check if already authenticated first
        if (await AuthService.IsAuthenticatedAsync())
        {
            Navigation.NavigateTo("/");
            return;
        }
        
        var currentUrl = Navigation.Uri;
        var returnUrl = Uri.EscapeDataString(new Uri(currentUrl).PathAndQuery);
        Navigation.NavigateTo($"{AuthenticationRoutes.LoginPath}?ReturnUrl={returnUrl}", forceLoad: true);
    }

    private void HandleLogout()
    {
        var currentUrl = Navigation.Uri;
        var returnUrl = Uri.EscapeDataString(new Uri(currentUrl).PathAndQuery);
        Navigation.NavigateTo($"{AuthenticationRoutes.LogoutPath}?ReturnUrl={returnUrl}", forceLoad: true);
    }

    public void Dispose()
    {
        SessionManager.SessionChanged -= OnSessionChanged;
    }
}