@using Website.Authentication.Routes
@using Website.Authentication.Interfaces
@inject NavigationManager Navigation
@inject IAuthenticationService AuthService
@inject IStringLocalizer<Localization> Localizer
@rendermode InteractiveServer
@implements IDisposable

<div class="auth-button">
    @if (isAuthenticated)
    {
        <button class="mx-4 btn btn-outline-danger px-4 py-3" @onclick="HandleLogout">
            @Localizer["Auth.Logout"]
        </button>
    }
    else
    {
        <button class="mx-4 btn btn-outline-primary px-4 py-3" @onclick="HandleLogin">
            @Localizer["Auth.Login"]
        </button>
    }
</div>

@code {
    private bool isAuthenticated = false;
    private Timer? refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAuthenticationState();
        
        // Set up a timer to periodically check authentication state
        refreshTimer = new Timer(async _ => 
        {
            await InvokeAsync(async () =>
            {
                await RefreshAuthenticationState();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(5));
    }

    private async Task RefreshAuthenticationState()
    {
        isAuthenticated = await AuthService.IsAuthenticatedAsync();
    }

    private async Task HandleLogin()
    {
        // Check if already authenticated first
        if (await AuthService.IsAuthenticatedAsync())
        {
            Navigation.NavigateTo("/");
            return;
        }
        
        Navigation.NavigateTo(AuthenticationRoutes.LoginPath, forceLoad: true);
    }

    private void HandleLogout()
    {
        Navigation.NavigateTo(AuthenticationRoutes.LogoutPath, forceLoad: true);
    }

    public void Dispose()
    {
        refreshTimer?.Dispose();
    }
}