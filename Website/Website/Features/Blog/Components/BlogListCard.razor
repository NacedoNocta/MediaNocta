@using BlogLibrary.Interfaces
@using Humanizer
@inject NavigationManager Navigation
@inject Website.Services.CultureService CultureService
@inject IStringLocalizer<Localization> Localizer
@rendermode InteractiveServer

<div class="col-12 col-md-6 col-lg-4 mb-3">
    <div class="card border-@blog.ThemeColor h-100 cursor-pointer" @onclick="OnCardClick">
        <div class="card-img-top overflow-hidden">
            <a href="@GetNavigationUrl()" class="d-block h-100">
                <img src="@GetImageUrl()" alt="Blog post image" class="card-img border border-1 border-@blog.ThemeColor object-fit-cover w-100" style="object-fit: cover;aspect-ratio: 2 / 1">
            </a>
        </div>
        <div class="card-body d-flex flex-column">
            <h5 class="card-title">
                <a href="@GetNavigationUrl()" class="text-decoration-none">@GetLocalizedTitle()</a>
                @if (IsBlogFeatured())
                {
                    <span class="badge bg-warning text-dark ms-2">@Localizer["Blog.Featured"]</span>
                }
                @if (GetBlogState() != BlogState.Published)
                {
                    <span class="badge bg-secondary ms-2">@GetBlogState()</span>
                }
            </h5>
            <p class="card-text mt-3 text-primary-emphasis flex-grow-1">
                @GetSummaryText()
            </p>
            @if (GetBlogTags().Any())
            {
                <div class="mb-2">
                    @foreach (var tag in GetBlogTags().Take(3))
                    {
                        <span class="badge bg-@GetTagColor(tag) me-1">@GetTagName(tag)</span>
                    }
                    @if (GetBlogTags().Count > 3)
                    {
                        <span class="text-muted small">+@(GetBlogTags().Count - 3) @Localizer["Blog.MoreTags"]</span>
                    }
                </div>
            }
        </div>
        <div class="card-footer text-muted d-flex justify-content-between align-items-center">
            <div>
                <a href="@GetNavigationUrl()" class="text-info text-decoration-none">@Localizer["Common.SeeMore"]</a>
                <small class="text-muted ms-2">@GetReadingTime()</small>
            </div>
            <div class="text-end">
                <small class="text-muted">@GetTimeAgoText()</small>
                @if (GetViewCount() > 0)
                {
                    <br/><small class="text-muted">@GetViewCount() @Localizer["Blog.Views"]</small>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public IBlog blog { get; set; } = default!;

    private string GetImageUrl()
    {
        return blog.ImageUrl ?? "https://placehold.co/600x400";
    }

    private string GetNavigationUrl()
    {
        return $"/blog/{blog.Id}/";
    }

    private string GetLocalizedTitle()
    {
        var currentLanguage = CultureService.GetCurrentCulture();
        return blog.Title.GetText(currentLanguage);
    }

    private string GetSummaryText()
    {
        if (blog.Summary == null)
            return "";

        var currentLanguage = CultureService.GetCurrentCulture();
        var localizedSummary = blog.Summary.GetText(currentLanguage);
        return localizedSummary.Truncate(150);
    }

    private string GetTimeAgoText()
    {
        if (blog.CreatedAt == default)
            return "";

        return blog.CreatedAt.Humanize().Transform(To.SentenceCase);
    }

    private bool IsBlogFeatured()
    {
        return blog.Featured;
    }

    private BlogState GetBlogState()
    {
        return blog is BlogLibrary.Blog concreteBlog ? concreteBlog.State : BlogState.Published;
    }

    private List<BlogLibrary.Tag> GetBlogTags()
    {
        return blog is BlogLibrary.Blog concreteBlog ? concreteBlog.Tags : new List<BlogLibrary.Tag>();
    }

    private string GetTagColor(BlogLibrary.Tag tag)
    {
        return !string.IsNullOrEmpty(tag.Color) ? tag.Color : "secondary";
    }

    private string GetTagName(BlogLibrary.Tag tag)
    {
        return tag.Name;
    }

    private string GetReadingTime()
    {
        if (blog is BlogLibrary.Blog concreteBlog && concreteBlog.ReadingTimeMinutes > 0)
        {
            return $"{concreteBlog.ReadingTimeMinutes} {Localizer["Blog.MinRead"]}";
        }
        return "";
    }

    private int GetViewCount()
    {
        return blog is BlogLibrary.Blog concreteBlog ? concreteBlog.Views : 0;
    }

    private void OnCardClick()
    {
        var navigationUrl = GetNavigationUrl();
        if (!string.IsNullOrEmpty(navigationUrl) && navigationUrl != "#")
        {
            Navigation.NavigateTo(navigationUrl);
        }
    }
}