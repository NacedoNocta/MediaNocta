@using SharedLibrary.Interfaces
@using Humanizer
@inject NavigationManager Navigation
@inject Website.Services.CultureService CultureService
@inject IStringLocalizer<Localization> Localizer

<div class="">
    <div class="card border-@activity.ThemeColor h-100 cursor-pointer" @onclick="OnCardClick">
        <div class="card-img-top overflow-hidden">
            <a href="@GetNavigationUrl()" class="d-block h-100">
                <img src="@GetImageUrl()" alt="Activity image" class="card-img border border-1 border-@activity.ThemeColor object-fit-cover w-100" style="object-fit: cover;aspect-ratio: 2 / 1">
            </a>
        </div>
        <div class="card-body d-flex flex-column">
            <h5 class="card-title">
                <a href="@GetNavigationUrl()" class="text-decoration-none">@GetActivityTitle()</a>
                @if (activity.Featured)
                {
                    <span class="badge bg-warning text-dark ms-2">@Localizer["Blog.Featured"]</span>
                }
            </h5>
            <p class="card-text mt-3 text-primary-emphasis flex-grow-1">
                @GetSummaryText()
            </p>
        </div>
        <div class="card-footer text-muted d-flex justify-content-between align-items-center">
            <div>
                <a href="@GetNavigationUrl()" class="text-info text-decoration-none">@Localizer["Common.SeeMore"]</a>
            </div>
            <div class="text-end">
                <small class="text-muted">@GetTimeAgoText()</small>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public IActivity activity { get; set; } = default!;

    private string GetImageUrl()
    {
        return activity.ImageUrl ?? "https://placehold.co/600x400";
    }

    private string GetNavigationUrl()
    {
        return activity.ActivityType?.ToLower() switch
        {
            "blog" => $"/blog/{activity.Id}",
            "tech" => $"/tech/{activity.Id}",
            "fragment" => $"/fragments/{activity.Id}",
            _ => "#"
        };
    }

    private string GetActivityTitle()
    {
        if (activity.Title == null)
            return "Untitled Activity";

        var currentLanguage = CultureService.GetCurrentCulture();
        return activity.Title.GetText(currentLanguage);
    }

    private string GetSummaryText()
    {
        if (activity.Summary == null)
            return "";

        var currentLanguage = CultureService.GetCurrentCulture();
        var localizedSummary = activity.Summary.GetText(currentLanguage);
        return localizedSummary.Truncate(150);
    }

    private string GetTimeAgoText()
    {
        if (activity.CreatedAt == default)
            return "";

        return activity.CreatedAt.Humanize().Transform(To.SentenceCase);
    }

    private void OnCardClick()
    {
        var navigationUrl = GetNavigationUrl();
        if (!string.IsNullOrEmpty(navigationUrl) && navigationUrl != "#")
        {
            Navigation.NavigateTo(navigationUrl);
        }
    }
}