@page "/403"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Access Denied - Backoffice</PageTitle>

<div class="container-fluid py-4">
    <div class="text-center mb-4">
        <div class="mb-4">
            <i class="bi bi-shield-lock-fill text-danger" style="font-size: 5rem;"></i>
        </div>

        <h1 class="display-4 text-danger mb-3">403 - Access Denied</h1>

        <p class="lead mb-4">
            You do not have the required permissions to access the Backoffice.
        </p>

        <div class="alert alert-warning d-inline-block mb-4" role="alert">
            <strong>Required Role:</strong> backoffice-admin
        </div>

        <div>
            <p class="mb-3">Please log out and sign in with an authorized account.</p>
            <a href="/Account/Logout" class="btn btn-primary btn-lg">
                <i class="bi bi-box-arrow-right me-2"></i>Logout
            </a>
        </div>
    </div>

    <!-- DEBUG INFORMATION -->
    <div class="card mt-5">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0">DEBUG: Authentication Information</h5>
        </div>
        <div class="card-body">
            @if (authState != null && authState.User.Identity?.IsAuthenticated == true)
            {
                <h6>User Identity:</h6>
                <ul>
                    <li><strong>Name:</strong> @authState.User.Identity.Name</li>
                    <li><strong>IsAuthenticated:</strong> @authState.User.Identity.IsAuthenticated</li>
                    <li><strong>AuthenticationType:</strong> @authState.User.Identity.AuthenticationType</li>
                </ul>

                <h6 class="mt-3">All Claims:</h6>
                <div class="table-responsive">
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th>Type</th>
                                <th>Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var claim in authState.User.Claims.OrderBy(c => c.Type))
                            {
                                <tr>
                                    <td><code>@claim.Type</code></td>
                                    <td>
                                        @if (claim.Type.Contains("token", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <small class="text-muted">[Token - @claim.Value.Length chars]</small>
                                            <details>
                                                <summary>Show token</summary>
                                                <pre class="mt-2" style="font-size: 0.75rem; max-height: 300px; overflow: auto;">@claim.Value</pre>
                                            </details>
                                        }
                                        else
                                        {
                                            @claim.Value
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <h6 class="mt-3">Roles Found:</h6>
                @if (authState.User.Claims.Any(c => c.Type == System.Security.Claims.ClaimTypes.Role || c.Type == "role"))
                {
                    <ul>
                        @foreach (var roleClaim in authState.User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role || c.Type == "role"))
                        {
                            <li><strong>@roleClaim.Value</strong> (from claim type: @roleClaim.Type)</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-danger">No role claims found!</p>
                }
            }
            else
            {
                <p class="text-warning">User is not authenticated</p>
            }
        </div>
    </div>
</div>

@code {
    private Microsoft.AspNetCore.Components.Authorization.AuthenticationState? authState;

    protected override async Task OnInitializedAsync()
    {
        authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    }
}
