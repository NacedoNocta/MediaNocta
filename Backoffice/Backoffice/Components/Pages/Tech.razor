@page "/tech"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "backoffice-admin")]
@using TechLibrary
@using Backoffice.Services
@inject ITechManagementService TechService
@rendermode InteractiveServer

<PageTitle>Tech Management - Media Nocta Backoffice</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-5">Tech Updates</h1>
        </div>
        <div class="col-auto">
            <button class="btn btn-success" @onclick="CreateNew">
                <i class="bi bi-plus-circle me-2"></i>Create New Tech Update
            </button>
        </div>
    </div>

    <div class="row">
        <div class="col">
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm  table-hover table-striped">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Title</th>
                                    <th>Project</th>
                                    <th>Update Type</th>
                                    <th>Created Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (techUpdates == null)
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4">
                                            <div class="spinner-border text-success" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else if (!techUpdates.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">
                                            No tech updates found. Create your first tech update to get started.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var tech in techUpdates)
                                    {
                                        <tr>
                                            <td>@tech.Id.ToString().Substring(0, 8)</td>
                                            <td>@tech.Title.English</td>
                                            <td>@tech.ProjectId</td>
                                            <td>
                                                <span class="badge bg-info">
                                                    @tech.UpdateType
                                                </span>
                                            </td>
                                            <td>@tech.CreatedAt.ToShortDateString()</td>
                                            <td>
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <button class="btn btn-outline-success" @onclick="() => Edit(tech.Id)">
                                                        <i class="bi bi-pencil-fill"></i> Edit
                                                    </button>
                                                    <button class="btn btn-outline-danger" @onclick="() => Delete(tech.Id)">
                                                        <i class="bi bi-trash-fill"></i> Delete
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<TechUpdate>? techUpdates;

    protected override async Task OnInitializedAsync()
    {
        await LoadTechUpdates();
    }

    private async Task LoadTechUpdates()
    {
        techUpdates = await TechService.GetAllTechUpdatesAsync(1, 100);
    }

    private void CreateNew()
    {
        // TODO: Navigate to create page
        Console.WriteLine("Create new tech update");
    }

    private void Edit(Guid id)
    {
        // TODO: Navigate to edit page
        Console.WriteLine($"Edit tech update {id}");
    }

    private async Task Delete(Guid id)
    {
        // TODO: Add confirmation dialog
        var success = await TechService.DeleteTechUpdateAsync(id);
        if (success)
        {
            await LoadTechUpdates();
        }
    }
}
